{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/watch/layout,_N_T_/watch/comm/layout,_N_T_/watch/comm/page,_N_T_/watch/comm"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/watch/comm/__PAGE__",
    "/watch/comm",
    "/watch",
    "/_index",
    "/_head"
  ]
}