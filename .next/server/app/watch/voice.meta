{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/watch/layout,_N_T_/watch/voice/layout,_N_T_/watch/voice/page,_N_T_/watch/voice"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/watch/voice/__PAGE__",
    "/watch/voice",
    "/watch",
    "/_index",
    "/_head"
  ]
}