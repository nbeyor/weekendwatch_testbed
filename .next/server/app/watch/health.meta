{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/watch/layout,_N_T_/watch/health/layout,_N_T_/watch/health/page,_N_T_/watch/health"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/watch/health/__PAGE__",
    "/watch/health",
    "/watch",
    "/_index",
    "/_head"
  ]
}