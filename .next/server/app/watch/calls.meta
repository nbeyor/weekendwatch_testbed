{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/watch/layout,_N_T_/watch/calls/layout,_N_T_/watch/calls/page,_N_T_/watch/calls"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/watch/calls/__PAGE__",
    "/watch/calls",
    "/watch",
    "/_index",
    "/_head"
  ]
}