{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/watch/layout,_N_T_/watch/media/layout,_N_T_/watch/media/page,_N_T_/watch/media"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/watch/media/__PAGE__",
    "/watch/media",
    "/watch",
    "/_index",
    "/_head"
  ]
}