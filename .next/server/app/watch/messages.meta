{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/watch/layout,_N_T_/watch/messages/layout,_N_T_/watch/messages/page,_N_T_/watch/messages"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/watch/messages/__PAGE__",
    "/watch/messages",
    "/watch",
    "/_index",
    "/_head"
  ]
}